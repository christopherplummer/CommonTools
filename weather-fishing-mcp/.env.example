# Keep this file's values out of source control after copying to .env.
WF_USER_AGENT=CommonTools-WeatherFishing/0.1 (replace-with-your-contact)
# Used when a tool call omits units: metric, imperial, or source.
# Explicit per-call units override this setting. Reload the MCP server after changes.
WF_DEFAULT_UNITS=metric
# Required only for HTTP transport; generate at least 32 random characters.
WF_API_KEY=
# Request an NCEI token at https://www.ncei.noaa.gov/cdo-web/token
WF_NCEI_TOKEN=
WF_QUOTA_DATABASE=data/quota.sqlite3
# The LM Studio launcher defaults this to true. Other clients default to false.
# Supply WF_TEXT_RESULTS=false in the MCP client environment to disable it there.
WF_TEXT_RESULTS=false
# These are operator review records, not grants of rights. Leave empty unless
# your actual agreement permits automated retrieval and this use of the data.
WF_SOLUNAR_PERMISSION_REFERENCE=
# Optional reviewed catalogues. Leave unset until real source evidence is reviewed.
# See docs/resolution-collection.md; never use model-authored relationship evidence.
# WF_STATION_RELATIONSHIPS_FILE=data/station-relationships.json
# WF_SOLUNAR_LOCALITIES_FILE=data/solunar-localities.json
# Global geocoding/timezone integration remains unselected/unconfigured.
# IANA source timezone for each requested city is supplied in tool arguments.
# No persistent provider response cache is used.
