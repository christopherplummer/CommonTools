# Generate each secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
SEARXNG_SECRET=
# Optional: separate credential held by a human, never given to an agent.
HUMAN_APPROVAL_KEY=
APP_HOST=0.0.0.0
APP_PORT=8000
SEARXNG_BASE_URL=http://searxng:8080
BROWSER_HEADLESS=true
BROWSER_ENABLED=true
BROWSER_MAX_SESSIONS=3
BROWSER_SESSION_TIMEOUT_SECONDS=900
DOWNLOAD_DIRECTORY=/data/downloads
MAX_DOWNLOAD_SIZE_MB=100
STORAGE_QUOTA_MB=1024
HTTP_REQUEST_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=60
MAX_FETCH_CHARS=12000
MAX_TOOL_RESPONSE_CHARS=24000
MAX_FETCH_BYTES=2000000
DATABASE_URL=sqlite:////data/webtools.db
LOG_LEVEL=INFO
# JSON arrays; production must not enable private-address test exceptions.
ALLOWED_PORTS=[80,443]
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","[::1]:*"]
